# ─────────────────────────────────────────────────────────────
# HegmaKart Frontend — LOCAL DEVELOPMENT environment
# ─────────────────────────────────────────────────────────────
# This file is loaded automatically by Create React App when
# you run: npm start
#
# NOTE: Using production API so that cart/checkout/address data
# (which lives on the production server) is accessible during
# local development. Switch to localhost:8000 only if running
# a full local backend stack.
# ─────────────────────────────────────────────────────────────

# Fix for react-scripts 5.0.1 allowedHosts schema validation error when proxy is set in package.json
DANGEROUSLY_DISABLE_HOST_CHECK=true

# GraphQL — pointing to production API (local Docker stack not running)
 REACT_APP_GRAPHQL_URL=http://localhost:8000/graphql/
# REACT_APP_GRAPHQL_URL=/graphql/
#REACT_APP_GRAPHQL_URL=https://www.hegmakart.com/graphql/
 
# Environment label (used for conditional logic if needed)
REACT_APP_ENV=development
 REACT_APP_REST_API_URL=http://localhost:3000
#REACT_APP_REST_API_URL=https://www.hegmakart.com
