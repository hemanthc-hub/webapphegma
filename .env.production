# ─────────────────────────────────────────────────────────────
# HegmaKart Frontend — PRODUCTION environment
# ─────────────────────────────────────────────────────────────
# This file is used when you run: npm run build
# ─────────────────────────────────────────────────────────────

# GraphQL (Production Saleor server)
REACT_APP_GRAPHQL_URL=https://www.hegmakart.com/graphql/

# Environment label
REACT_APP_ENV=production

# REST API Base URL
REACT_APP_REST_API_URL=https://www.hegmakart.com

# OTP API (served by the Flask REST backend)
REACT_APP_OTP_API_URL=https://www.hegmakart.com

# REACT_APP_GRAPHQL_URL=https://www.hegmakart.com/graphql/
# REACT_APP_REST_API_URL=https://www.hegmakart.com